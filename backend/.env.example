YOUTUBE_API_KEY=your_youtube_data_api_key_here
REDIS_URL=redis://localhost:6380/0
MAX_DOWNLOAD_CONCURRENT=8
MAX_PROCESS_CONCURRENT=4
APP_ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3001

# Production auth gate. Set REQUIRE_AUTH=true before exposing the API publicly.
# SERVICE_API_KEY is optional for internal automation/backend-to-backend calls.
REQUIRE_AUTH=false
SERVICE_API_KEY=
ALLOWED_VIDEO_HOSTS=youtube.com,youtu.be,tiktok.com,vimeo.com,instagram.com,facebook.com,fb.watch,loom.com
MAX_UPLOAD_MB=1024
MAX_DOWNLOAD_MB=1024
MAX_SOURCE_DURATION_SECONDS=1800

# SaaS billing and compliance gates. Enable these before exposing a paid app.
BILLING_REQUIRED=false
REQUIRE_RIGHTS_ATTESTATION=false
DEFAULT_PLAN=pro
ALLOWED_SUBSCRIPTION_STATUSES=active,trialing
MONTHLY_DOWNLOAD_LIMIT=500
MONTHLY_PROCESS_LIMIT=500
MONTHLY_TRANSCRIPTION_LIMIT=500
MONTHLY_VARIANT_LIMIT=100
MONTHLY_TIMELINE_RENDER_LIMIT=500
APP_URL=http://localhost:3001
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_RETURN_URL=http://localhost:3001/account

# Optional: Gemini-assisted long-form variant planning.
# Keep real keys in backend/.env only. Do not commit them.
GOOGLE_AI_API_KEYS=key1,key2,key3
GOOGLE_AI_MODEL=gemini-2.0-flash
UPLOADS_DIR=uploads

# Optional: API transcription. auto = Groq first when keys exist, then Deepgram, then faster-whisper fallback.
TRANSCRIPTION_PROVIDER=auto
GROQ_API_KEYS=key1,key2
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_LANGUAGE=auto
DEEPGRAM_API_KEYS=key1,key2
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=auto

# Optional: Supabase/Postgres persistence for video state, subtitles, and timeline projects.
# Keep real Supabase keys and database passwords in backend/.env only. Do not commit them.
STATE_STORE_BACKEND=sqlite
STATE_STORE_FALLBACK_TO_SQLITE=true
DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_URL=
